+"""Phase 2A.1 CPU adapter contract tests. Synthetic cases, not model outputs."""
+import copy
+import json
+import pytest
+from ai_gateway.workflow_parser import parse_workflow_script
+from ai_gateway.web_adapters import to_web_ai_full, to_web_ai_semi
+
+
+@pytest.mark.parametrize('workflow,speech', [
+    ('full-ai', '"Giữ nguyên: \r\n  lời thoại!  "'),
+    ('full-ai', '  Exact punctuation… “yes”  '),
+    ('semi', '"Narration: \r\n  Footage: spoken words."'),
+])
+def test_one_canonical_spoken_field_with_exact_json_roundtrip(workflow, speech):
+    field = 'Dialogue' if workflow == 'full-ai' else 'Voiceover'
+    other = 'Voiceover' if workflow == 'full-ai' else 'Dialogue'
+    speech = speech if speech.startswith('"') else '"' + speech + '"'
+    prefix = 'Character: Judge' if workflow == 'full-ai' else 'Time_origin: 0 - 2'
+    source = f'scene_1\r\n{prefix}\r\n{field}: {speech}\r\n'
+    parsed = parse_workflow_script(source, workflow)
+    saved = copy.deepcopy(parsed.model_dump())
+    result = (to_web_ai_full if workflow == 'full-ai' else to_web_ai_semi)(parsed, source)
+    scene = json.loads(json.dumps(result.web_data, ensure_ascii=False))['scenes'][0]
+    assert scene[field] == speech
+    assert other not in scene
+    assert scene['Word_count'] == len(speech.split())
+    assert parsed.model_dump() == saved
