+function storyboard(scene, projectType = 'full-ai', extra = {}) {
+  return StoryboardTab({ parsedData: [scene], projectCharacters: [], generatedAudios: { 1: '/existing.mp3' },
+    isGenerating: {}, mergingScenes: {}, mergedVideos: { 1: '/merged.mp4' }, projectType,
+    ...extra });
+}
+for (const [name, speech, projectType, expected] of [
+  ['new Full', { Dialogue: exact }, 'full-ai', exact],
+  ['legacy Full', { Voiceover: exact }, 'full-ai', exact],
+  ['Semi', { Voiceover: exact, Dialogue: 'ignored' }, 'semi', exact],
+]) {
