+def test_cancelled_handshake_reaps_owned_child(tmp_path,monkeypatch):
+    child=tmp_path/'cancel_cpu.py';child.write_text(PREFIX+'import time\ntime.sleep(30)\n',encoding='utf-8')
+    retained=[]
+    attach=WorkerJob.attach_owned
+    def capture(self,process):
+        attach(self,process);retained.append((process,self))
+    monkeypatch.setattr(WorkerJob,'attach_owned',capture)
+    async def run():
+        task=asyncio.create_task(spawn_contained([sys.executable,'-I','-B',str(child)],cwd=str(tmp_path),env={},timeout=5))
+        async def attached():
+            while not retained:await asyncio.sleep(.01)
+        try:
+            await asyncio.wait_for(attached(),5)
+        finally:
+            task.cancel()
+            with pytest.raises(asyncio.CancelledError):await task
+        proc,job=retained[0]
+        assert proc.returncode is not None and job.handle is None
+    asyncio.run(run())
